{
  "name": "super-canvas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @super-canvas/runtime... build && pnpm --filter @super-canvas/web dev",
    "dev:worker": "pnpm --filter @super-canvas/runtime... build && pnpm --filter @super-canvas/worker dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm --filter @super-canvas/runtime... build && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm --filter @super-canvas/web lint",
    "db:generate": "pnpm --filter @super-canvas/db db:generate",
    "db:migrate": "pnpm --filter @super-canvas/db db:migrate",
    "format": "pnpm exec prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  }
}
