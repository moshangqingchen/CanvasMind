{
  "name": "super-canvas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @super-canvas/runtime... build && pnpm --filter @super-canvas/web dev",
    "dev:worker": "pnpm --filter @super-canvas/runtime... build && pnpm --filter @super-canvas/worker dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm --filter @super-canvas/runtime... build && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm --filter @super-canvas/web lint",
    "clean": "node scripts/clean.mjs",
    "clean:deep": "node scripts/clean.mjs --deep",
    "gc:storage": "node scripts/storage-gc.mjs",
    "gc:storage:apply": "node scripts/storage-gc.mjs --apply",
    "director:sync": "node scripts/sync-super-director.mjs",
    "public:prepare": "pnpm --filter @super-canvas/providers build && node scripts/prepare-local-public.mjs",
    "public:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-public-managed.ps1",
    "public:watch": "pnpm public:prepare && pnpm public:start",
    "db:generate": "pnpm --filter @super-canvas/db db:generate",
    "db:migrate": "pnpm --filter @super-canvas/db db:migrate",
    "format": "pnpm exec prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  }
}
