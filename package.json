{
  "name": "super-canvas",
  "version": "0.2.66",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "desktop:dev": "node scripts/dev-desktop.mjs",
    "desktop:dev:production": "node scripts/build-desktop.mjs --run",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:lock": "node apps/desktop/scripts/update-runtime-lock.mjs",
    "desktop:start": "pnpm --filter @super-canvas/desktop start",
    "desktop:test": "pnpm --filter @super-canvas/desktop test",
    "dev": "pnpm desktop:dev",
    "start": "pnpm desktop:start",
    "build": "pnpm desktop:build",
    "build:runtime": "pnpm --filter @super-canvas/desktop-ui... build",
    "typecheck": "pnpm --filter @super-canvas/runtime... --filter @super-canvas/director... build && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm --filter @super-canvas/desktop-ui lint",
    "clean": "node scripts/clean.mjs",
    "clean:check": "node scripts/clean.mjs --dry-run",
    "clean:deep": "node scripts/clean.mjs --deep",
    "test:maintenance": "node --test scripts/*.test.mjs",
    "benchmark:repository": "pnpm --filter @super-canvas/db build && node scripts/benchmark-repository.mjs",
    "gc:storage": "node scripts/storage-gc.mjs",
    "gc:storage:apply": "node scripts/storage-gc.mjs --apply",
    "director:sync": "node scripts/sync-super-director.mjs",
    "format": "pnpm exec prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  }
}
