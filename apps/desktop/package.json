{
  "name": "@super-canvas/desktop",
  "version": "0.2.45",
  "private": true,
  "description": "超级画布 Windows 桌面版",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "stage": "node scripts/stage.mjs",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@super-canvas/providers": "workspace:*",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "sharp": "0.35.4"
  },
  "build": {
    "appId": "com.supercanvas.desktop",
    "productName": "超级画布",
    "executableName": "SuperCanvas",
    "directories": { "output": "release", "buildResources": "assets" },
    "files": ["dist/**", "package.json"],
    "extraResources": [
      { "from": "dist/app-update.yml", "to": "app-update.yml" },
      { "from": "stage", "to": "runtime" },
      { "from": "assets/icon.ico", "to": "app-icon.ico" },
      { "from": "src/runtime-hook.cjs", "to": "runtime/runtime-hook.cjs" }
    ],
    "asar": true,
    "releaseInfo": { "releaseNotesFile": "dist/release-notes.md" },
    "npmRebuild": false,
    "artifactName": "SuperCanvas-Setup-${version}-${arch}.${ext}",
    "win": { "target": ["nsis"], "icon": "assets/icon.ico" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": { "provider": "github", "owner": "moshangqingchen", "repo": "CanvasMind", "releaseType": "release" }
  }
}
