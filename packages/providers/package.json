{
  "name": "@super-canvas/providers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./suppliers": {
      "types": "./src/suppliers.ts",
      "import": "./dist/suppliers.js",
      "default": "./dist/suppliers.js"
    },
    "./weai-models": {
      "types": "./src/weai-models.ts",
      "import": "./dist/weai-models.js",
      "default": "./dist/weai-models.js"
    },
    "./model-catalog": {
      "types": "./src/model-catalog.ts",
      "import": "./dist/model-catalog.js",
      "default": "./dist/model-catalog.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "undici": "8.9.0"
  }
}
