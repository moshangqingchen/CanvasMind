# Desktop source build only. Normal App settings and API keys live in the
# local profile; Electron supplies the DPAPI-protected key and session at launch.
NEXT_TELEMETRY_DISABLED=1
# Development isolation, optional. Packaged builds always use the standard profile.
# SUPERCANVAS_DESKTOP_TEST_ROOT=C:/path/to/isolated-desktop-profile
# Optional process environment overrides, integers 1..64; Electron forwards these.
# RUNTIME_RUN_CONCURRENCY=2
# RUNTIME_GLOBAL_CONCURRENCY=4
# RUNTIME_PROVIDER_CONCURRENCY=2
# RUNTIME_CONNECTION_CONCURRENCY=2
# Performance regression gates on a fixed test machine (milliseconds).
# See docs/optimization-2026-09-22.md for available benchmark commands.
