# Leave DATABASE_URL and REDIS_URL empty for the local development mode.
# Docker Compose requires both values and should use the service hostnames
# `postgres` and `redis` (see docs/self-hosting.md).
DATABASE_URL=
# true/default = persistent local JSON; ephemeral = process memory only;
# false + DATABASE_URL = PostgreSQL.
USE_MEMORY_STORE=true
# Local development data survives restarts in this JSON file.
LOCAL_DATABASE_PATH=./data/super-canvas.json
# Project archive root. Defaults to <working directory>\项目.
SUPERCANVAS_PROJECT_ROOT=
REDIS_URL=
# Leave these empty for in-process development; the Docker Compose service
# injects its internal endpoint explicitly.
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=supercanvas
S3_FORCE_PATH_STYLE=true
MASTER_KEY=
# Public HTTPS origin used by webhooks and providers such as Miaowu that fetch
# reference media only from public URL fields.
PUBLIC_BASE_URL=
# Optional browser-side fast path for downloads when the public tunnel and the
# local canvas service run on the same computer.
NEXT_PUBLIC_LOCAL_DOWNLOAD_ORIGIN=http://127.0.0.1:3210
# Optional local upgrade/debug bridge to an already-running Super Canvas API.
API_PROXY_BASE_URL=
NEXT_PUBLIC_APP_NAME=超级画布
NEXT_PUBLIC_APP_VERSION=0.2.11
NEXT_PUBLIC_DIRECTOR_ENABLED=true
RUN_IN_PROCESS=true
WORKER_CONCURRENCY=2
# Windows local-public manager only. The default 2048 MB ceiling makes an
# unexpected regression restart cleanly instead of exhausting the host.
SUPERCANVAS_NODE_MAX_OLD_SPACE_MB=2048

# Windows local Release updater. Public repositories need no token.
SUPERCANVAS_UPDATE_ENABLED=true
SUPERCANVAS_UPDATE_REPOSITORY=moshangqingchen/CanvasMind
SUPERCANVAS_UPDATE_INTERVAL_SECONDS=600
# SUPERCANVAS_GITHUB_TOKEN=

# Single-account login. Leave all three empty to run without a login prompt.
# Once they are set, EVERY hostname requires a session; only loopback is exempt.
SUPERCANVAS_PUBLIC_AUTH_USER=
SUPERCANVAS_PUBLIC_AUTH_PASSWORD=
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SUPERCANVAS_PUBLIC_AUTH_SESSION_TOKEN=
# Optional comma-separated hostnames that may skip the login prompt.
SUPERCANVAS_PUBLIC_AUTH_TRUSTED_HOSTS=
# Set to false to require login from localhost as well.
SUPERCANVAS_PUBLIC_AUTH_ALLOW_LOOPBACK=

# Docker Compose credentials. Keep these empty until you replace them with
# unique secrets; compose refuses to start while any required value is empty.
POSTGRES_USER=supercanvas
POSTGRES_PASSWORD=
POSTGRES_DB=supercanvas
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_APP_USER=
MINIO_APP_PASSWORD=

# Optional: bypass a local TUN/Fake-IP proxy for long-running We-AI calls.
# Native runs may use the physical adapter's IPv4. In Docker, leave this empty
# unless the address is assigned inside the container. Only *.we-token.cc uses it.
WEAI_DIRECT_LOCAL_ADDRESS=
WEAI_DIRECT_DNS_SERVERS=223.5.5.5,119.29.29.29
